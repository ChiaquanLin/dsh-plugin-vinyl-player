# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Raw serialisation of the React tree, written by artifact-check for inspection.
# It is not a valid standalone image, so it never belongs in the repository.
# The README links docs/*.svg instead, which render-shot and render-diagram make.
tools/*.svg

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local environment
.env
.env.*
!.env.example

# Credentials. A .npmrc holds a registry token, and an interrupted run must never
# be able to commit one. The plugin has no registry release, so nothing legitimate
# creates this file.
.npmrc
*.pem
*.key

tools/artifact-raw.svg
